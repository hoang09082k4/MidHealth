# Local Vite development only; production uses the same origin as the Node server.
VITE_API_BASE_URL=http://localhost:4000
# Optional: set all four values together when using another Firebase project.
# These identify the public web app; never put Supabase service keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
