@startuml
title Admin xử lý sự cố và chuyển lịch khám
autonumber
skinparam ParticipantFontSize 10
actor "Admin" as Admin
boundary "Giao diện quản trị\nD:\MidHealth\frontend\src\components\admin\admin_dashboard" as UI
control "MidHealth API\nD:\MidHealth\backend\src\server\nD:\MidHealth\backend\src\admin_service" as API
database "CSDL MidHealth — Supabase PostgreSQL\nD:\MidHealth\supabase\schema\nschema public\npublic.appointments\npublic.appointment_slots\npublic.admin_events\npublic.appointment_email_outbox" as DB

Admin -> UI: Chọn lịch bị ảnh hưởng, nhập lý do
UI -> API: POST /api/admin/appointments/{id}/disruption
API -> DB: UPDATE public.appointments; INSERT public.admin_events
Admin -> UI: Chọn slot thay thế
UI -> API: POST /api/admin/appointments/{id}/reschedule
API -> DB: RPC public.reschedule_clinic_appointment
DB -> DB: UPDATE public.appointments, public.appointment_slots; INSERT public.admin_events, public.appointment_email_outbox
DB --> API: Lịch mới / không còn slot
API --> UI: Kết quả xử lý
UI --> Admin: Xác nhận lịch mới hoặc báo lỗi
@enduml
