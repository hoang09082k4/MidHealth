@startuml
title Bệnh nhân xem lịch hẹn và phiếu khám
autonumber
skinparam ParticipantFontSize 10
actor "Bệnh nhân" as Patient
boundary "Cổng bệnh nhân\nD:\MidHealth\frontend\src\lib\appointments\nD:\MidHealth\frontend\src\components\phieu_kham\phieu_kham_dien_tu" as UI
control "MidHealth API\nD:\MidHealth\backend\src\server\nD:\MidHealth\backend\src\appointment_service" as API
database "CSDL MidHealth — Supabase PostgreSQL\nD:\MidHealth\supabase\schema\nschema public\npublic.appointments\npublic.queue_tickets\npublic.appointment_attachments\npublic.clinical_encounters\npublic.appointment_clinical_notes\npublic.prescription_items" as DB

Patient -> UI: Mở danh sách lịch hẹn
UI -> API: GET /api/appointments
API -> DB: SELECT public.appointments, public.queue_tickets, public.appointment_attachments, public.clinical_encounters, public.appointment_clinical_notes, public.prescription_items
DB --> API: Lịch, ticket, hồ sơ khám
API --> UI: Danh sách lịch và chi tiết
UI --> Patient: Hiển thị lịch/phiếu/kết quả
@enduml
