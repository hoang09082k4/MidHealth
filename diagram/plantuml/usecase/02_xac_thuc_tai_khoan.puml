@startuml
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam linetype polyline
skinparam ArrowThickness 1
skinparam nodesep 32
skinparam ranksep 38
skinparam actorStyle stickman
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
  ArrowColor #000000
}
title Use case đăng ký và xác thực tài khoản

actor "Khách truy cập /\nBệnh nhân" as Patient
actor "Tài khoản nội bộ\n(nhân viên, bác sĩ,\ntrưởng khoa, Admin)" as InternalUser
actor "Dịch vụ email OTP" as Email
actor "Firebase Authentication" as Firebase

  usecase "Đăng ký bệnh nhân" as Register
  usecase "Đăng ký bằng email" as RegisterEmail
  usecase "Đăng ký bằng Google" as RegisterGoogle
  usecase "Xác minh email\nbằng mã OTP" as VerifyOTP
  usecase "Tạo tài khoản, đặt mật khẩu\nvà hoàn tất hồ sơ" as CompleteRegistration
  usecase "Hoàn tất hồ sơ và mật khẩu\nở lần đăng ký Google đầu tiên" as CompleteGoogle

  usecase "Đăng nhập tài khoản" as Login
  usecase "Đăng nhập bằng email\nvà mật khẩu" as LoginEmail
  usecase "Đăng nhập bằng Google" as LoginGoogle
  usecase "Đặt lại mật khẩu" as ResetPassword
  usecase "Kiểm tra vai trò và\ntrạng thái tài khoản" as CheckAccess
  usecase "Đăng xuất" as Logout

Patient -- Register
Patient -- Login
Patient -- Logout
InternalUser -- Login
InternalUser -- Logout
Email -- VerifyOTP
Firebase -- RegisterGoogle
Firebase -- LoginEmail
Firebase -- LoginGoogle

RegisterEmail ..> Register : <<extend>> [chọn đăng ký email]
RegisterGoogle ..> Register : <<extend>> [chọn đăng ký Google]
RegisterEmail ..> VerifyOTP : <<include>>
RegisterEmail ..> CompleteRegistration : <<include>>
CompleteGoogle ..> RegisterGoogle : <<extend>> [đăng ký lần đầu]
LoginEmail ..> Login : <<extend>> [chọn đăng nhập email]
LoginGoogle ..> Login : <<extend>> [chọn đăng nhập Google]
ResetPassword ..> LoginEmail : <<extend>> [chọn quên mật khẩu]
LoginEmail ..> CheckAccess : <<include>>
LoginGoogle ..> CheckAccess : <<include>>


@enduml

