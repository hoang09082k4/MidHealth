PORT=4000
TRUST_PROXY=false
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_PROJECT_ID=your_firebase_project_id
# Required for admin password resets for clinic staff/doctors.
# Recommended: keep the service-account JSON outside the repository and use its absolute path.
# Grant that account Firebase Authentication Admin (roles/firebaseauth.admin) in this project.
# FIREBASE_CLIENT_EMAIL=your-service-account@midhealth-1c1b9.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# Recommended alternative to inline key variables. Never commit the JSON file.
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/midhealth-firebase-service-account.json

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

JWT_SECRET=replace_with_a_long_random_secret
OTP_EXPIRES_MINUTES=5
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
PAYPAL_CURRENCY=USD
PAYPAL_VND_TO_USD_RATE=25000
PAYPAL_RETURN_URL=http://localhost:4000/api/payments/paypal/return
PAYPAL_CANCEL_URL=http://localhost:4000/api/payments/paypal/cancel

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
